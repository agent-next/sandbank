{
  "name": "sandbank-cloudflare-bridge",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-01-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DRAIN": "0" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "max_instances": 3,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "REGISTRY", "class_name": "SandboxRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox", "SandboxRegistry"] }
  ]
}
